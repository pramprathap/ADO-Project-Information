{
  "manifestVersion": 1,
  "id": "veelead-project-information",
  "publisher": "PRamprathap",
  "version": "1.9.2",
  "name": "Project Information",
  "description": "Maintain structured, project-scoped information under Project Settings. Data is stored per project using the official Azure DevOps project-properties API.",
  "public": false,
  "categories": ["Azure Repos"],
  "tags": ["project", "settings", "governance", "delivery", "metadata"],
  "icons": {
    "default": "public/icons/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "links": {
    "support": {
      "uri": "https://www.veelead.com"
    }
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": ["vso.project", "vso.project_write", "vso.graph", "vso.work"],
  "demands": ["api-version/7.1"],
  "contributions": [
    {
      "id": "project-information-hub",
      "type": "ms.vss-web.hub",
      "description": "Project Information page under Project Settings.",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "Project Information",
        "order": 100,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "project-health-hub",
      "type": "ms.vss-web.hub",
      "description": "Project Health report page under Project Settings.",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "Project Health",
        "order": 101,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "organization-overview-hub",
      "type": "ms.vss-web.hub",
      "description": "Organization-wide portfolio Overview across all projects.",
      "targets": [
        "ms.vss-web.collection-admin-hub-group",
        "ms.vss-web.organization-admin-hub-group"
      ],
      "properties": {
        "name": "Portfolio Overview",
        "order": 89,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "organization-resource-hub",
      "type": "ms.vss-web.hub",
      "description": "Organization-wide Resource Allocation (capacity vs allocation).",
      "targets": [
        "ms.vss-web.collection-admin-hub-group",
        "ms.vss-web.organization-admin-hub-group"
      ],
      "properties": {
        "name": "Resource Allocation",
        "order": 91,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "organization-effort-hub",
      "type": "ms.vss-web.hub",
      "description": "Organization-wide Effort & Timesheet (planned vs submitted vs approved).",
      "targets": [
        "ms.vss-web.collection-admin-hub-group",
        "ms.vss-web.organization-admin-hub-group"
      ],
      "properties": {
        "name": "Effort & Timesheet",
        "order": 92,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "organization-weekly-hub",
      "type": "ms.vss-web.hub",
      "description": "Weekly / Daily status report with PDF & PPT export.",
      "targets": [
        "ms.vss-web.collection-admin-hub-group",
        "ms.vss-web.organization-admin-hub-group"
      ],
      "properties": {
        "name": "Weekly Status",
        "order": 93,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    },
    {
      "id": "organization-health-hub",
      "type": "ms.vss-web.hub",
      "description": "Organization-wide Project Health report with a project picker.",
      "targets": [
        "ms.vss-web.collection-admin-hub-group",
        "ms.vss-web.organization-admin-hub-group"
      ],
      "properties": {
        "name": "Project Health",
        "order": 90,
        "uri": "dist/project-information.html",
        "icon": "public/icons/extension-icon.png"
      }
    }
  ],
  "files": [
    {
      "path": "dist/project-information.html",
      "addressable": true
    },
    {
      "path": "public/icons",
      "addressable": true
    }
  ]
}
